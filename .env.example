# Management (admin) HTTP Basic Auth for the example server.js host.
ADMIN_USER=admin
ADMIN_PASS=changeme

# Default model id passed to the claude CLI adapter. Override for your setup.
GUEST_MODEL=claude-opus-4-6

# Where session/room JSON is stored (created on first write).
DATA_DIR=./data

# Port for the example host.
PORT=3000

# --- Multi-room MCP chat (lib/mcp-room.js) ---

# Local endpoint that receives debounced "someone spoke" pushes for
# inject-subscribed participants. Point this at your own always-on harness.
# ROOM_INJECT_URL=http://127.0.0.1:3000/api/inject
# ROOM_INJECT_DELAY_MS=120000

# Public base URL used in minted invite links / MCP setup instructions.
# ROOM_PUBLIC_BASE=https://pier.example.com

# IANA timezone used to format timestamps shown to humans (default: UTC).
# TZ_DISPLAY=America/New_York

# --- Webhooks (lib/webhooks.js) ---
# Reuses ROOM_INJECT_URL above for delivering inbound hook pings.
